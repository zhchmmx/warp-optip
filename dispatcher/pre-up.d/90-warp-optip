#!/bin/sh
#
# WARP 优选 pre-up 钩子（同步）
# 安装到 /etc/NetworkManager/dispatcher.d/pre-up.d/90-warp-optip
#
# 这个脚本在 NetworkManager 激活 WireGuard 的“正在连接”阶段运行。
# 它最多等待 WARP_PREUP_TIMEOUT 秒，失败/超时也返回 0，让连接正常起来。
#

[ -f /etc/warp-optip.conf ] || exit 0
. /etc/warp-optip.conf

mkdir -p /run/warp-optip 2>/dev/null || true
echo "[$(date '+%F %T')] pre-up-hook action=${NM_DISPATCHER_ACTION:-${1:-}} id=${CONNECTION_ID:-} type=${CONNECTION_TYPE:-} iface=${DEVICE_IFACE:-}" \
    >> /run/warp-optip/dispatcher.log 2>/dev/null || true

# NetworkManager 提供的是 NM_DISPATCHER_ACTION（新版本），
# 同时兼容历史上用 $1 传 action 的调用方式。
action="${NM_DISPATCHER_ACTION:-${1:-}}"
[ "$action" = "pre-up" ] || exit 0

# 部分 NetworkManager 版本不会设置 CONNECTION_TYPE（为空）。
# 连接名已经足够唯一，这里只在 type 有值时做一次过滤。
if [ -n "${CONNECTION_TYPE:-}" ] && [ "$CONNECTION_TYPE" != "wireguard" ]; then
    exit 0
fi
[ "$CONNECTION_ID" = "${WARP_CONN:-warp-optip}" ] || exit 0

mkdir -p "${WARP_STATE_DIR:-/var/lib/warp-optip}" 2>/dev/null || true
mkdir -p /run/warp-optip 2>/dev/null || true

# 服务自己触发的重新 up 不再扫描
if [ -f /run/warp-optip/self-up ]; then
    now=$(date +%s)
    ts=$(cat /run/warp-optip/self-up 2>/dev/null || echo 0)
    if [ $((now - ts)) -lt 60 ]; then
        exit 0
    fi
fi

timeout --signal=TERM --kill-after=5s "${WARP_PREUP_TIMEOUT:-25}s" \
    /usr/local/bin/warp-optip pre-up \
    >> /run/warp-optip/pre-up.log 2>&1

exit 0
