#!/bin/sh
#
# WARP 优选 up 后校验钩子（异步）
# 安装到 /etc/NetworkManager/dispatcher.d/90-warp-optip-verify
#

[ -f /etc/warp-optip.conf ] || exit 0
. /etc/warp-optip.conf

mkdir -p /run/warp-optip 2>/dev/null || true
echo "[$(date '+%F %T')] verify-hook action=${NM_DISPATCHER_ACTION:-${1:-}} id=${CONNECTION_ID:-} type=${CONNECTION_TYPE:-} iface=${DEVICE_IFACE:-}" \
    >> /run/warp-optip/dispatcher.log 2>/dev/null || true

# NetworkManager 提供的是 NM_DISPATCHER_ACTION（新版本），
# 同时兼容历史上用 $1 传 action 的调用方式。
action="${NM_DISPATCHER_ACTION:-${1:-}}"
[ "$action" = "up" ] || exit 0

# 部分 NetworkManager 版本不会设置 CONNECTION_TYPE（为空）。
# 连接名已经足够唯一，这里只在 type 有值时做一次过滤。
if [ -n "${CONNECTION_TYPE:-}" ] && [ "$CONNECTION_TYPE" != "wireguard" ]; then
    exit 0
fi
[ "$CONNECTION_ID" = "${WARP_CONN:-warp-optip}" ] || exit 0

# 服务正在运行时不重复启动
systemctl is-active --quiet warp-optip.service && exit 0

# 服务自己触发的 up 不递归
if [ -f /run/warp-optip/self-up ]; then
    now=$(date +%s)
    ts=$(cat /run/warp-optip/self-up 2>/dev/null || echo 0)
    if [ $((now - ts)) -lt 60 ]; then
        rm -f /run/warp-optip/self-up
        exit 0
    fi
fi

systemctl start --no-block warp-optip.service
